# 必填：会话签名密钥。请使用随机长字符串，禁止使用此示例值。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars

# 仅用于 admins 表为空时的首次引导。
# 首次启动会创建 username=admin 的 super 账号；已有管理员不会被覆盖。
# 首次登录后请立即在后台为每个管理员设置互不相同的强密码。
# 生产环境建议通过受保护的 secret 文件注入，而不是写进 shell 历史。
ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password

# Docker 默认值；裸机运行时可按需调整。
DATA_DIR=/data
UPLOAD_DIR=/uploads

# SQLite 之外的投递码高水位文件。必须和数据库分开备份，不能从旧备份静默覆盖。
CODE_SEQUENCE_FLOOR_FILE=/runtime/code-sequence-high-water.json

# 可选运行参数
HOST=0.0.0.0
PORT=3000
TZ=Asia/Shanghai
NODE_ENV=production
